{
  "name": "@thinkingos/vsl-mcp-server",
  "version": "0.1.1",
  "description": "VSL MCP Server — Model Context Protocol integration for AI agents (Claude Desktop, Cline, TaoCoder)",
  "license": "SEE LICENSE IN LICENSE.txt",
  "type": "module",
  "bin": {
    "mcp-server": "./dist/index.js",
    "mcp-server-setup": "./bin/setup.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:coverage": "npm test -- --coverage",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "setup": "node bin/setup.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@thinkingos/vsl-sdk": "^0.1.1",
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
